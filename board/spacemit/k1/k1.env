/*
 * Shared K1 load addresses, inside the first DRAM bank and below 4 GiB.
 * Keep payloads clear of OpenSBI's protected region at address zero and
 * U-Boot's relocation near the top of RAM. The filesystem EFI bootmeth
 * reads to kernel_addr_r; it must not fall back to address zero.
 */

kernel_addr_r=0x10000000
kernel_comp_addr_r=0x18000000
kernel_comp_size=0x4000000
fdt_addr_r=0x1c000000
scriptaddr=0x1c100000
pxefile_addr_r=0x1c200000
ramdisk_addr_r=0x1c300000
