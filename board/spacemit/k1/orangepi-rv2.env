/*
 * Environment for the OrangePi RV2.
 *
 * Load addresses stay inside the first DRAM bank (0x0 - 0x7fffffff), below
 * the 4 GiB line the K1's 32-bit DMA masters cannot cross; the second bank
 * of this 4 GiB board starts at 0x1_0000_0000. OpenSBI sits at the bottom
 * of the first bank and U-Boot relocates to its top. Without these the efi
 * bootmeth reads the payload to address 0, into OpenSBI's PMP-protected
 * region.
 */

kernel_addr_r=0x10000000
kernel_comp_addr_r=0x18000000
kernel_comp_size=0x4000000
fdt_addr_r=0x1c000000
scriptaddr=0x1c100000
pxefile_addr_r=0x1c200000
ramdisk_addr_r=0x1c300000
