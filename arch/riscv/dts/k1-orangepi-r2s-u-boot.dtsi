#include "binman.dtsi"
#include "k1-opp-u-boot.dtsi"

/*
 * U-Boot-only additions for the OrangePi R2S. The hardware description itself
 * comes from the upstream device tree (spacemit/k1-orangepi-r2s.dts).
 */

/*
 * The eMMC is the SPL boot device, which spl_boot_device() names as
 * BOOT_DEVICE_MMC1, MMC device 0, as on the other K1 boards. With
 * CONFIG_SPL_DM_SEQ_ALIAS this alias keeps it device 0 whatever else binds.
 */
/ {
	aliases {
		mmc0 = &emmc;
	};
};

&{/soc} {
	bootph-pre-ram;

	/*
	 * The DDR controller is not described upstream. SPL's LPDDR4X init and
	 * ddr_get_density() both read their configuration from here.
	 *
	 * PERF: 2400 is the vendor-safe rate and is what this board runs. The
	 * LPDDR4X part and the frequency table also offer 3200, but that was
	 * tested on hardware 2026-08-20 and FAILED the SPL DRAM pattern test
	 * ("dram pattern test failed!" -> load access fault): 3200 exceeds this
	 * board's signal integrity. Do not raise it.
	 *
	 * cs-num = 1: the R2S is single-rank. The CS1 MAP register still reads
	 * back populated, so without this the size is double-counted as 4 GiB.
	 */
	dramc: ddr@c0000000 {
		compatible = "spacemit,k1-ddr";
		reg = <0x0 0xc0000000 0x0 0x400000>;
		datarate = <2400>;
		cs-num = <1>;
		type = "LPDDR4X";
		bootph-pre-ram;
	};
};

&{/cpus} {
	bootph-pre-ram;
};

/*
 * Clock infrastructure. The K1 clock driver is a DM/CCF driver bound to these
 * syscon and oscillator nodes, so every one of them has to exist in the SPL
 * device tree -- without them spl_early_init() fails in uclass setup (-96)
 * before the console is even up.
 */
&osc_32k {
	bootph-pre-ram;
};

&vctcxo_1m {
	bootph-pre-ram;
};

&vctcxo_3m {
	bootph-pre-ram;
};

&vctcxo_24m {
	bootph-pre-ram;
};

&pll {
	bootph-pre-ram;
};

&syscon_mpmu {
	bootph-pre-ram;
};

&syscon_apmu {
	bootph-pre-ram;
};

&syscon_apbc {
	bootph-pre-ram;
};

&cpu_0 {
	bootph-pre-ram;
};

&clint {
	clock-frequency = <24000000>;
	bootph-pre-ram;
};

&uart0 {
	bootph-pre-ram;
};

/*
 * eMMC is the SPL boot device. Its
 * parent simple-bus must be bound in SPL too, or DM never scans down to it.
 */
&{/soc/storage-bus} {
	bootph-pre-ram;
};

/*
 * The eMMC io clock runs at 204.8 MHz (PLL1 409.6 MHz / 2). The OS reads the
 * live rate into the 8-bit SDHCI v3 base-clock field, which the 409.6 MHz the
 * BootROM leaves overflows, and then overclocks the card.
 */
&emmc {
	max-frequency = <204800000>;
	bootph-pre-ram;
};

/*
 * The SpacemiT P1 PMIC on the power-management I2C bus is described upstream.
 * OpenSBI's "spacemit-p1-reset" system-reset device binds to that node;
 * without it OpenSBI does not advertise SBI_EXT_SRST and every OS that
 * reboots through SBI halts instead of resetting.
 *
 * The cores run from its buck1. Linux caps buck1 and buck2, the CPU core
 * rails, at the 1.05 V of the fastest operating point (merged after v7.2),
 * and gives every CPU node buck1 as its cpu-supply (posted after v7.2).
 * board_init() raises the rail through cpu-supply before it moves the
 * clusters to their fastest operating point.
 */
&i2c8 {
	pmic@41 {
		regulators {
			buck1_0v9: buck1 {
				regulator-max-microvolt = <1050000>;
			};

			buck2 {
				regulator-max-microvolt = <1050000>;
			};
		};
	};
};

&cpu_0 {
	cpu-supply = <&buck1_0v9>;
};

&cpu_1 {
	cpu-supply = <&buck1_0v9>;
};

&cpu_2 {
	cpu-supply = <&buck1_0v9>;
};

&cpu_3 {
	cpu-supply = <&buck1_0v9>;
};

&cpu_4 {
	cpu-supply = <&buck1_0v9>;
};

&cpu_5 {
	cpu-supply = <&buck1_0v9>;
};

&cpu_6 {
	cpu-supply = <&buck1_0v9>;
};

&cpu_7 {
	cpu-supply = <&buck1_0v9>;
};

/*
 * The TLV EEPROM (an AT24C02 at 0x50 on i2c2, as on upstream's other K1
 * boards). The SPL reads the product name and the DDR rank count from it;
 * U-Boot proper reads the MAC addresses (CONFIG_ID_EEPROM).
 */
&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_0_cfg>;
	status = "okay";
	bootph-pre-ram;

	eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <16>;
		read-only;
		size = <256>;
		bootph-pre-ram;
	};
};

/*
 * Without the in-tree LPDDR4X driver (CONFIG_SPACEMIT_K1_DDR), the SPL runs
 * SpacemiT's DDR training firmware, which binman appends to it as upstream's
 * K1 boards do. DDR_FW_FILE names the firmware; without it the section holds
 * an empty placeholder and the in-tree driver's builds do not use it.
 */
&binman {
	u-boot-spl-ddr {
		type = "section";
		filename = "u-boot-spl-ddr.bin";
		pad-byte = <0xff>;

		u-boot-spl {
		};

		ddr-fw {
			type = "blob";
			filename = "ddr_fw.bin";
			align = <64>;
		};

		u-boot-any {
			type = "section";
			size = <0>;
			offset = <0>;
		};
	};
};
